# Base URL of the Q-Gati backend (FastAPI) — see ../backend/README.md.
#
# The NEXT_PUBLIC_ prefix is required: the browser calls this API directly
# (map tiles, scenario creation, optimize), so the value must be inlined into
# the client bundle at build time rather than read on the server.
#
# Copy to .env.local and change it if the backend runs elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:8000
